general {
    output_format = "i3bar"
    colors = true
    interval = 5
}

order += "cpu_usage"
order += "memory"
order += "disk /"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "tztime local"

cpu_usage {
    format = " CPU %usage"
    max_threshold = 75
    degraded_threshold = 25
}

memory {
    format = " MEM %used / %total"
    threshold_degraded = "1G"
    threshold_critical = "200M"
}

disk "/" {
    format = " DISK %avail"
}

wireless _first_ {
    format_up = " %essid %quality"
    format_down = " wifi off"
}

ethernet _first_ {
    format_up = " %ip"
    format_down = " eth off"
}

battery all {
    format = "%status %percentage %remaining"
    format_down = "No battery"
    status_chr = "CHG"
    status_bat = "BAT"
    status_unk = "UNK"
    status_full = "FULL"
    status_idle = "IDLE"
    low_threshold = "15"
    threshold_type = "percentage"
    last_full_capacity = true
}

tztime local {
    format = " %Y-%m-%d %H:%M"
}
