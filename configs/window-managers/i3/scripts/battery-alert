#!/usr/bin/env bash
# Dynamic battery reporting. Test overrides never require changes to real sysfs.
set -u
export LC_ALL=C

ROOT=${BATTERY_SYSFS_ROOT:-/sys/class/power_supply}
declare -a names=()
declare -A levels states health
total_now=0 total_full=0 complete=1 ac=unknown

number() {
    local value
    value=$(cat "$1" 2>/dev/null) || return 1
    [[ $value =~ ^[0-9]+$ && ${#value} -le 15 ]] || return 1
    printf '%s' "$((10#$value))"
}

scan() {
    local path name type present level status now full design h online voltage
    for path in "$ROOT"/*; do
        [[ -d $path ]] || continue
        type=$(cat "$path/type" 2>/dev/null) || continue
        if [[ $type != Battery ]]; then
            if online=$(number "$path/online"); then
                [[ $ac == unknown ]] && ac=0
                [[ $online == 1 ]] && ac=1
            fi
            continue
        fi
        present=$(cat "$path/present" 2>/dev/null) || present=1
        [[ $present != 0 ]] || continue
        name=${path##*/}
        status=$(cat "$path/status" 2>/dev/null) || status=Unknown
        level=$(number "$path/capacity") || level=unknown
        h=unknown
        if now=$(number "$path/energy_now") && full=$(number "$path/energy_full") && ((full > 0)); then
            total_now=$((total_now + now))
            total_full=$((total_full + full))
            [[ $level != unknown ]] || level=$(((now * 100 + full / 2) / full))
            if design=$(number "$path/energy_full_design") && ((design > 0)); then
                h=$(((full * 100 + design / 2) / design))
            fi
        elif now=$(number "$path/charge_now") && full=$(number "$path/charge_full") && ((full > 0)); then
            [[ $level != unknown ]] || level=$(((now * 100 + full / 2) / full))
            if design=$(number "$path/charge_full_design") && ((design > 0)); then
                h=$(((full * 100 + design / 2) / design))
            fi
            if voltage=$(number "$path/voltage_min_design") && ((voltage > 0)); then
                # uAh * uV / 1e6 = uWh. Use awk to avoid integer overflow.
                total_now=$((total_now + $(awk -v q="$now" -v v="$voltage" 'BEGIN {printf "%.0f", q*v/1000000}')))
                total_full=$((total_full + $(awk -v q="$full" -v v="$voltage" 'BEGIN {printf "%.0f", q*v/1000000}')))
            else
                complete=0
            fi
        else
            complete=0
        fi
        [[ $level == unknown ]] || { ((level <= 100)) || level=100; }
        names+=("$name")
        levels[$name]=$level states[$name]=$status health[$name]=$h
    done
}

summary() {
    local name charge condition
    for name in "${names[@]}"; do
        charge=${levels[$name]}
        [[ $charge == unknown ]] || charge+=%
        condition=${health[$name]}
        [[ $condition == unknown ]] || condition+=%
        printf '%s: %s — %s (Health: %s)\n' "$name" "$charge" "${states[$name]}" "$condition"
    done
    if ((${#names[@]} > 1 && complete && total_full > 0)); then
        local combined=$(((total_now * 100 + total_full / 2) / total_full))
        ((combined <= 100)) || combined=100
        printf 'Combined charge: %s%%\n' "$combined"
    fi
}

notify() {
    notify-send -a 'Battery Monitor' -u "${3:-normal}" -- "$1" "$2"
}

monitor() {
    local runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    local cache="$runtime/battery-monitor" name previous band level old_status old_ac charge
    umask 077
    mkdir -p "$cache" || return 1
    exec 9>"$cache/lock"
    flock -n 9 || return 0
    old_ac=$(cat "$cache/ac" 2>/dev/null) || old_ac=unknown
    if [[ $ac != unknown && $old_ac != unknown && $ac != "$old_ac" ]] && ((${#names[@]})); then
        if [[ $ac == 1 ]]; then
            notify 'Charger Connected' "$(summary)" || return 1
        else
            notify 'Charger Disconnected' "$(summary)" || return 1
        fi
    fi
    printf '%s' "$ac" >"$cache/ac"
    for previous in "$cache"/*.present; do
        [[ -f $previous ]] || continue
        name=${previous##*/}
        name=${name%.present}
        if [[ ! -v levels[$name] ]]; then
            notify 'Battery Removed' "$name is no longer detected." || return 1
            rm -f "$previous" "$cache/$name.band" "$cache/$name.status"
        fi
    done
    for name in "${names[@]}"; do
        if [[ -f $cache/initialized && ! -f $cache/$name.present ]]; then
            notify 'Battery Detected' "$name has been detected." || continue
        fi
        touch "$cache/$name.present"
        level=${levels[$name]}
        band=normal
        previous=$(cat "$cache/$name.band" 2>/dev/null) || previous=normal
        if [[ ${states[$name]} == Discharging && $level != unknown ]]; then
            if ((level <= 5)); then
                band=critical
            elif ((level <= 20)); then
                band=low
            fi
        elif [[ ${states[$name]} == Full ]] || [[ $level == 100 && (${states[$name]} == Charging || ${states[$name]} == 'Not charging') ]]; then
            band=full
        fi
        if [[ $band != "$previous" ]]; then
            case $band in
            critical) notify 'Critical Battery' "$name has $level% battery remaining. Please connect the charger." critical || continue ;;
            low) notify 'Low Battery' "$name has $level% battery remaining." critical || continue ;;
            full) notify 'Battery Fully Charged' "$name is fully charged." || continue ;;
            esac
        fi
        printf '%s' "$band" >"$cache/$name.band"
        old_status=$(cat "$cache/$name.status" 2>/dev/null) || old_status=${states[$name]}
        if [[ $old_status != "${states[$name]}" && $band == normal ]]; then
            charge=$level
            [[ $charge == unknown ]] || charge+=%
            notify "Battery $name" "$name: $charge — ${states[$name]}" || continue
        fi
        printf '%s' "${states[$name]}" >"$cache/$name.status"
        if [[ ${health[$name]} != unknown ]] && ((${health[$name]} < 50)) && [[ ! -f $cache/$name.health ]]; then
            if notify 'Battery Health Warning' "$name battery health is low: ${health[$name]}%. Consider replacing the battery."; then
                touch "$cache/$name.health"
            fi
        fi
    done
    touch "$cache/initialized"
}

case "${1:---check}" in
--help | -h)
    echo 'Usage: battery-alert [--status|--notify|--check|--help]'
    exit 0
    ;;
--status)
    scan
    summary
    ;;
--notify)
    scan
    if ((${#names[@]})); then notify 'Battery Status' "$(summary)"; fi
    ;;
--check)
    scan
    monitor
    ;;
*)
    echo 'Unknown option. Use --help.' >&2
    exit 1
    ;;
esac
