#!/usr/bin/env bash

# Compatibility entry point. Read actual power supplies, not an assumed BAT0.

case "${1:-}" in
charging | discharging) exec bash "$(dirname "${BASH_SOURCE[0]}")/battery-alert" --check ;;
--help | -h) echo 'Usage: battery-charging charging|discharging (run as the desktop user)' ;;
*)
    echo 'Expected charging or discharging.' >&2
    exit 1
    ;;
esac
